@model Productos

<form asp-action="Crear" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="row mt-3">
        <div class="col-md-6">
            <div>
                <label asp-for="Nombre"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-md-6">
            <div>
                <label asp-for="PrecioKilo"></label>
                <input asp-for="PrecioKilo" class="form-control" type="number"/>
                <span asp-validation-for="PrecioKilo" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Principal" class="btn btn-dark">Regresar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}