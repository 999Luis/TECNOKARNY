@using System.Globalization
@model TECNOKARNY.Models.Ventas
@{
    ViewData["Title"] = "Detalle de venta";
    var cultura = CultureInfo.GetCultureInfo("es-MX");
}
  
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        @if (ViewBag.IdCliente != null)
        {
            <a asp-controller="Clientes" asp-action="VentasCliente" asp-route-id="@ViewBag.IdCliente" class="btn btn-dark mt-4 mb-4">Regresar</a>
        }
        else
        {
            <a asp-action="Principal" class="btn btn-success mt-4 mb-4">Regresar</a>
        }
        
        <h4 class="mb-0">Detalle de venta <span>#@Model.Id</span></h4>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Información de la venta</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <strong>Cliente: </strong>
                    <span>@Model.IdClienteNavigation.Nombre</span>
                </div>
                <div class="col-md-4 mb-3">
                    <strong>Usuario: </strong>
                    <span>@Model.IdUsuarioNavigation.Nombre</span>
                </div>
                <div class="col-md-4 mb-3">
                    <strong>Fecha: </strong>
                    <span>@Model.Fecha.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="col-md-4 mb-3">
                    <strong>Tipo: </strong>
                    <span>@Model.Tipo</span>
                </div>
            
                <strong>Estado: </strong>
                @if (Model.Estado == "Cancelada")
                {
                    <div class="col-md-4 mb-3">
                        <span class="badge bg-danger">Cancelada</span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <strong>Motivo de cancelación: </strong>
                        <span>@Model.MotivoCancelacion</span>
                    </div>
                }
                else
                {
                    <div class="col-md-4 mb-3">
                        <span class="badge bg-success">Activa</span>
                    </div>
                    
                }

                @if (Model.Tipo.Trim().Equals("Crédito", StringComparison.OrdinalIgnoreCase) == true)
                {
                    <div class="col-md-4 mb-3">
                        <strong>Fecha de vencimiento: </strong>
                        <span>@Model.FechaVencimiento?.ToString("dd/MM/yyyy")</span>
                    </div>
                }
                <div class="card mb-4">
                    <div class="card-header fw-semibold">Productos</div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Producto</th>
                                        <th>Cantidad (kg)</th>
                                        <th>Precio por Kg</th>
                                        <th>Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in Model.DetalleVenta)
                                    {
                                        <tr>
                                            <td>@detalle.IdProductoNavigation?.Nombre</td>
                                            <td>@detalle.Cantidad.ToString("", cultura)</td>
                                            <td>@detalle.PrecioKilo.ToString("C", cultura)</td>
                                            <td>@detalle.Subtotal.ToString("C", cultura)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row justify-content-end">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <label>Monto Total</label>
                                <strong>@Model.MontoTotal.ToString("C", cultura)</strong>
                            </div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between">
                                <label>Saldo</label>
                                @if (Model.Saldo > 0)
                                {
                                    <strong class="text-danger">@Model.Saldo.ToString("C", cultura)</strong>
                                }
                                else
                                {
                                    if (Model.Estado == "Cancelada")
                                    {
                                        <strong class="text-danger">Cancelada</strong>
                                    }
                                    else
                                    {
                                        <strong class="text-success">Pagada</strong>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>