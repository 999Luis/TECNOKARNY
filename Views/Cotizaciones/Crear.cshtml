@model TECNOKARNY.Models.CotizacionViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Nueva Cotización";
}

<h3 class="mt-4">Nueva Cotización</h3>

<form asp-action="Crear" method="post" id="formCotizacion">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row mt-3">
        <div class="col-md-6">
            <label asp-for="IdCliente">Cliente</label>
            <select asp-for="IdCliente" asp-items="ViewBag.Clientes" class="form-select" required>
                <option value="">-- Seleccionar cliente --</option>
            </select>
            <span asp-validation-for="IdCliente" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Direccion">Dirección del evento</label>
            <input asp-for="Direccion" class="form-control" required />
            <span asp-validation-for="Direccion" class="text-danger"></span>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-4">
            <label asp-for="FechaEvento">Fecha del evento</label>
            <input asp-for="FechaEvento" type="date" class="form-control" id="FechaEvento"
                   min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
            <span asp-validation-for="FechaEvento" class="text-danger"></span>
            <span id="mensajeFecha" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Hora">Hora</label>
            <input asp-for="Hora" type="time" class="form-control" required />
            <span asp-validation-for="Hora" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Asistentes">No. de asistentes</label>
            <input asp-for="Asistentes" type="number" class="form-control" min="1" required />
            <span asp-validation-for="Asistentes" class="text-danger"></span>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-4 d-flex align-items-center gap-2 mt-4">
            <input asp-for="Anticipo" type="checkbox" class="form-check-input" id="Anticipo" />
            <label asp-for="Anticipo" class="form-check-label">¿Pagó anticipo?</label>
        </div>
    </div>

    <input asp-for="IdUsuario" type="hidden" value="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value" />

    <h5 class="mt-4 mb-3">Productos cotizados</h5>

    <div class="table-responsive">
        <table class="table table-bordered" id="tablaProductos">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad (Kg)</th>
                    <th>Precio por Kilo</th>
                    <th>Precio Cotizado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="bodyProductos">
                <tr id="filaVacia" class="text-center text-muted">
                    <td colspan="5">Agrega los productos de la cotización</td>
                </tr>
            </tbody>
        </table>
    </div>

    <button type="button" class="btn mb-3" style="background-color:#9a0000; color:white;"
            id="btnAgregarProducto">Agregar Producto</button>

    <div class="row mt-3">
        <div class="col-md-8"></div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h6>Saldo Total: <strong id="saldoTotal">$0.00</strong></h6>
                </div>
            </div>
        </div>
    </div>

    <input asp-for="SaldoTotal" type="hidden" id="inputSaldoTotal" />

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Guardar Cotización</button>
        <a asp-action="Principal" class="btn btn-dark">Regresar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Verificar fecha ocupada en tiempo real
        document.getElementById("FechaEvento").addEventListener("change", async function () {
            const fecha = this.value;
            const msg = document.getElementById("mensajeFecha");
            if (!fecha) { msg.textContent = ""; return; }

            const res = await fetch(`/Cotizaciones/VerificarFecha?fecha=${fecha}`);
            const data = await res.json();

            if (data.ocupada) {
                msg.textContent = "⚠ Ya existe una cotización activa para esa fecha.";
                this.value = "";
            } else {
                msg.textContent = "";
            }
        });

        const productosData = @Html.Raw(ViewBag.ProductosJSON);
        let contadorFilas = 0;

        document.getElementById("btnAgregarProducto").addEventListener("click", agregarFila);

        document.getElementById("formCotizacion").addEventListener("submit", function (e) {
            if (document.querySelectorAll("#bodyProductos tr:not(#filaVacia)").length === 0) {
                e.preventDefault();
                alert("Debe agregar al menos un producto.");
            }
        });

        function agregarFila() {
            const tbody = document.getElementById("bodyProductos");
            const filaVacia = document.getElementById("filaVacia");
            if (filaVacia) filaVacia.remove();

            const idsSeleccionados = Array.from(document.querySelectorAll(".productoSelect"))
                .map(s => s.value).filter(v => v !== "");

            const disponibles = productosData.filter(p => !idsSeleccionados.includes(String(p.Id)));

            if (disponibles.length === 0) {
                alert("No hay más productos para agregar.");
                return;
            }

            const fila = document.createElement("tr");
            fila.id = "fila_" + contadorFilas;
            fila.innerHTML = `
                <td>
                    <select class="form-select productoSelect" name="Detalles[${contadorFilas}].IdProducto" required>
                        <option value="">-- Seleccionar --</option>
                        ${disponibles.map(p => `<option value="${p.Id}" data-precio="${p.PrecioKilo}">${p.Nombre}</option>`).join("")}
                    </select>
                </td>
                <td>
                    <input type="number" class="form-control cantidad" name="Detalles[${contadorFilas}].Cantidad"
                           step="0.01" value="1" min="0.01" required />
                </td>
                <td>
                    <input type="number" class="form-control precioKilo" name="Detalles[${contadorFilas}].PrecioKilo"
                           step="0.01" value="0" readonly />
                </td>
                <td>
                    <input type="number" class="form-control precioCotizado" name="Detalles[${contadorFilas}].PrecioCotizado"
                           step="0.01" value="0" readonly />
                </td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm btnEliminar">Eliminar</button>
                </td>
            `;

            tbody.appendChild(fila);

            const select = fila.querySelector(".productoSelect");
            const cantidad = fila.querySelector(".cantidad");
            const precio = fila.querySelector(".precioKilo");
            const cotizado = fila.querySelector(".precioCotizado");

            select.addEventListener("change", function () {
                const opt = this.options[this.selectedIndex];
                precio.value = (parseFloat(opt.dataset.precio) || 0).toFixed(2);
                calcularCotizado(cantidad, precio, cotizado);
                calcularTotal();
            });

            cantidad.addEventListener("input", function () {
                calcularCotizado(cantidad, precio, cotizado);
                calcularTotal();
            });

            fila.querySelector(".btnEliminar").addEventListener("click", function () {
                fila.remove();
                if (document.querySelectorAll("#bodyProductos tr").length === 0) {
                    tbody.innerHTML = '<tr id="filaVacia" class="text-center text-muted"><td colspan="5">Agrega los productos de la cotización</td></tr>';
                }
                calcularTotal();
            });

            contadorFilas++;
        }

        function calcularCotizado(cantidad, precio, cotizado) {
            const cant = parseFloat(cantidad.value) || 0;
            const prec = parseFloat(precio.value) || 0;
            cotizado.value = (cant * prec).toFixed(2);
        }

        function calcularTotal() {
            let total = 0;
            document.querySelectorAll(".precioCotizado").forEach(i => {
                total += parseFloat(i.value) || 0;
            });
            document.getElementById("saldoTotal").textContent = "$" + total.toFixed(2);
            document.getElementById("inputSaldoTotal").value = total.toFixed(2);
        }
    </script>
}
