@model Usuarios

<form asp-action="Actualizar" method="post">
    <input type="hidden" asp-for="Id">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="row mt-3">
            <div class="col-md-6">
                <div>
                    <label asp-for="Nombre"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-md-6">
                <div>
                    <label asp-for="Correo"></label>
                    <input asp-for="Correo" class="form-control" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
            </div>
        </div>
         <div class="row mt-3">
            <div class="col-md-6">
                <div>
                    <label asp-for="Pwd"></label>
                    <input asp-for="Pwd" class="form-control" />
                    <span asp-validation-for="Pwd" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-md-6">
                <div>
                    <label asp-for="IdRol"></label>
                    <select class="form-select" asp-for="IdRol" asp-items="ViewBag.IdRol"></select>
                    <span asp-validation-for="IdRol" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Actualizar</button>
            <a asp-action="Principal" class="btn btn-dark">Regresar</a>
        </div>
    </form>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }