@model TECNOKARNY.Models.Login
@{
    Layout = "~/Views/shared/_LayoutLogin.cshtml";
}
<div class="container-fluid vh-100">
    <div class="row h-100">
        <div class="col-md-7 d-none d-md-flex text-white justify-content-center align-items-center"  style="background-color: #9a0000;">
            <div class="text-center px-5">
                <h1 class="display-4 fw-bold">
                    TECNOKARNY
                </h1>
                <p class="lead">
                    Plataforma para la administración y control del sistema.
                </p>
            </div>
        </div>
        <div class="col-md-5 d-flex justify-content-center align-items-center bg-light">
            <div style="width:90%; max-width:450px;">
                <h3 class="fw-bold mb-4 text-center">
                    Iniciar sesión
                </h3>
                <form method="post" asp-action="Login">
                    <div class="mb-3">
                        <label class="form-label">Usuario</label>
                        <input asp-for="Usuario" class="form-control form-control-lg" placeholder="Ingrese usuario"
                               required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Contraseña</label>
                        <input asp-for="Contrasenia" type="password" class="form-control form-control-lg"
                               placeholder="Ingrese contraseña" required>
                    </div>
                    <div class="d-grid">
                        <button class="btn btn-success btn-lg" style="background-color: #9a0000;">
                            Entrar
                        </button>
                         <a asp-action="Bienvenida" asp-controller="Inicio" class="btn btn-secondary btn-lg mt-3">
                            Regresar
                        </a>
                    </div>
                    @if (ViewBag.Error != null)
                    {
                        <div class="row">
                            <h3 class="text-center text-danger">@ViewBag.Error</h3>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>