@{
    ViewData["Title"] = "Menú de Inicio";
}

<div class="container-fluid">
    <div class="row align-items-center">
        <div class="col-lg-9 p-2">
            @if (User.Identity!.IsAuthenticated)
            {
                <h1 class="display-5 fw-bold mb-4">
                    ¡Bienvenido @User.Identity.Name! - Menú Principal
                </h1>
            }
        </div>
    </div>

    <div class="container">
        <div class="row g-4 justify-content-center">

            @if (User.IsInRole("Administrador"))
            {
                <div class="col-md-4 col-sm-6 d-flex justify-content-center">
                    <a asp-action="Principal" asp-controller="Usuarios">
                        <img src="~/images/Usuarios.png" class="img-fluid" style="width:16rem;" alt="Usuarios">
                    </a>
                </div>

                <div class="col-md-4 col-sm-6 d-flex justify-content-center">
                    <a asp-action="Principal" asp-controller="Productos">
                        <img src="~/images/Productos.png" class="img-fluid" style="width:16rem;" alt="Productos">
                    </a>
                </div>
            }

            <div class="col-md-4 col-sm-6 d-flex justify-content-center">
                <a asp-action="Principal" asp-controller="Clientes">
                    <img src="~/images/Clientes.png" class="img-fluid" style="width:16rem;" alt="Clientes">
                </a>
            </div>

            <div class="col-md-4 col-sm-6 d-flex justify-content-center">
                <a asp-action="Principal" asp-controller="Ventas">
                    <img src="~/images/Ventas.png" class="img-fluid" style="width:16rem;" alt="Ventas">
                </a>
            </div>

            <div class="col-md-4 col-sm-6 d-flex justify-content-center">
                <a asp-action="Principal" asp-controller="Cotizaciones">
                    <img src="~/images/Cotizaciones.png" class="img-fluid" style="width:16rem;" alt="Cotizaciones">
                </a>
            </div>

            <div class="col-md-4 col-sm-6 d-flex justify-content-center">
                <a asp-action="Principal" asp-controller="Pagos">
                    <img src="~/images/Pagos.png" class="img-fluid" style="width:16rem;" alt="Pagos">
                </a>
            </div>

        </div>
    </div>
</div>