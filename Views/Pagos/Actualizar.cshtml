@model Pagos

<form asp-action="Actualizar" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="row mt-3">
        <div class="col-md-6">
            <div>
                <label asp-for="Nombre"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-md-6">
            <div>
                <label asp-for="Tipo"></label>
                <select class="form-select" asp-for="Tipo">
                    <option value="Materia Prima">Materia Prima</option>
                    <option value="Insumos">Insumos</option>
                    <option value="Servicios">Servicios</option>
                </select>
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-md-6">
            <div>
                <label asp-for="Telefono"></label>
                <input asp-for="Telefono" class="form-control" type="phone" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-md-6">
            <div>
                <label asp-for="FechaPago"></label>
                <input asp-for="FechaPago" class="form-control" type="date"/>
                <span asp-validation-for="FechaPago" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-md-6">
            <div>
                <label asp-for="Monto"></label>
                <input asp-for="Monto" class="form-control" type="number"/>
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-md-6">
            <div>
                <label asp-for="Descripcion"></label>
                <textarea asp-for="Descripcion" class="form-control"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-md-6">
            <div>
                <label asp-for="IdUsuario"></label>
                <select class="form-select" asp-for="IdUsuario" asp-items="ViewBag.IdUsuario"></select>
                <span asp-validation-for="IdUsuario" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Principal" class="btn btn-dark">Regresar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}