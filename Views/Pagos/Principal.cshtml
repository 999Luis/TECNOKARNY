@using System.Globalization
@model IEnumerable<TECNOKARNY.Models.Pagos>
@{
    var culture = (CultureInfo)CultureInfo.CurrentCulture.Clone();
    culture.NumberFormat.CurrencySymbol = "$";
    ViewData["Title"] = "Pagos";
}
<div class="d-flex align-items-center gap-2 mt-4 mb-4 flex-wrap">
    <a asp-action="Crear" class="btn btn-success">Registrar</a>
    <a asp-controller="Inicio" asp-action="MenuInicio" class="btn btn-secondary"
       style="background-color: #9a0000;">Inicio</a>
        <a asp-action="Informe" class="btn btn-info">Informe</a>
    <form method="get" asp-action="Principal" asp-controller="Pagos" class="d-flex gap-2 ms-auto">
        <input type="text" name="busqueda" value="@ViewBag.Busqueda" class="form-control" placeholder="Buscar por nombre..."
               style="width:220px;" />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        @if (!string.IsNullOrEmpty(ViewBag.Busqueda as string))
        {
            <a asp-action="Principal" class="btn btn-outline-danger">Limpiar</a>
        }
    </form>
</div>
<table class="table table-hovered table-bordered">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Teléfono</th>
            <th>Fecha de pago</th>
            <th>Monto</th>
            <th>Descripción</th>
            <th>Usuario</th>
            <th> </th>
        </tr>
        <tbody>
            @foreach (Pagos pago in Model)
            {
                <tr>
                    <td>@pago.Nombre</td>
                    <td>@pago.Tipo</td>
                    <td>@pago.Telefono</td>
                    <td>@pago.FechaPago</td>
                    <td>@String.Format(culture, "{0:C}", pago.Monto)</td>
                    <td>@pago.Descripcion</td>
                    <td>@pago.IdUsuarioNavigation.Nombre</td>
                    <td><a asp-route-id="@pago.Id" class="btn btn-warning" asp-action="Actualizar">Actualizar</a></td>
                </tr>
            }
        </tbody>
    </thead>
</table>